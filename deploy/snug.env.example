# Snug configuration. Copy to /etc/snug/snug.env and fill in.
# Every setting is described in docs/configuration.md.

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SNUG_SECRET_KEY=

# Required. The host name people will use, with no https:// or path.
SNUG_DOMAIN=room.example.com

# Optional. Where the database and files live, inside the container.
# SNUG_DATA_DIR=/var/lib/snug

# Optional. The proxy in front of Snug (Caddy), whose X-Forwarded-For is
# believed. The standard Compose file sets this for its own network.
# SNUG_TRUSTED_PROXIES=127.0.0.1/32, ::1/128
