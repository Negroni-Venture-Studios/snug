# Snug configuration, kept in /opt/snug/snug.env. sudo snug setup fills in the
# secret key, the domain and the company's name.
# The settings are in docs/configuration.md.

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SNUG_SECRET_KEY=

# Required. The host name people will use, with no https:// or path.
SNUG_DOMAIN=room.example.com

# Optional. Where the database and files live, inside the container.
# SNUG_DATA_DIR=/var/lib/snug

# Optional. The proxy in front of Snug (Caddy), whose X-Forwarded-For and
# X-Forwarded-Proto are believed. The standard Compose file sets this itself,
# overriding this line.
# SNUG_TRUSTED_PROXIES=127.0.0.1/32, ::1/128

# Optional. How many days a viewer stays verified on a link, from 1 to 90.
# SNUG_VIEWER_SESSION_DAYS=7

# The company's name is set in Settings under Branding. This is used until it is.
# SNUG_COMPANY_NAME=Fernlea Robotics

# Email is usually set up in Settings, and these are used until it is. See docs/email.md.
# On DigitalOcean, ports 25, 465 and 587 are blocked: use your provider's
# alternative port, such as 2525, or 2587 for Amazon SES.
# SNUG_EMAIL_FROM=rooms@example.com
# SNUG_SMTP_HOST=smtp.example-provider.com
# SNUG_SMTP_PORT=2525
# SNUG_SMTP_USERNAME=
# SNUG_SMTP_PASSWORD=
# SNUG_SMTP_SECURITY=starttls
